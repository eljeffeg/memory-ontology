@prefix work: <http://nova.dev/work#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://nova.dev/work#>
    a owl:Ontology ;
    rdfs:label "Work Ontology"@en ;
    dcterms:title "Work Ontology"@en ;
    dcterms:description "A small upper vocabulary for agents, artifacts, work items, changes, and topics. Memory records and time stay outside this file."@en ;
    dcterms:issued "2026-11-04"^^xsd:date ;
    owl:versionIRI <http://nova.dev/work/0.2.0> ;
    owl:versionInfo "0.2.0" ;
    vann:preferredNamespacePrefix "work" ;
    vann:preferredNamespaceUri "http://nova.dev/work#" ;
    rdfs:seeAlso <http://nova.dev/temporal#> , <http://www.w3.org/ns/prov#> , <http://se-on.org/> , <http://purl.obolibrary.org/obo/swo.owl> , <https://schema.org/> ;
    rdfs:comment "Subclass, inverse, domain, and range infer additional facts. They do not reject a second value, an unknown status, or a dangling object. This vocabulary declares no owl:FunctionalProperty and no owl:imports."@en ;
    skos:editorialNote "work:partOf and work:dependsOn are transitive. That inference runs in an RL profile. QL still uses the asserted triple and its inverse. work:dependsOn is not a confirm-policy functional predicate."@en ;
    skos:editorialNote "Person, Organization, Product, Project, Place, Event, Document, and Concept are the broad entity classes. Every extracted entity gets one of them or Artifact, WorkItem, or Change. A domain vocabulary such as software adds narrower subclasses."@en ;
    skos:editorialNote "A single current status, assignee, or path is a confirm policy on a memory record, the same mechanism a caller uses for a functional predicate. It is not an OWL functional axiom."@en .

work:Agent
    a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "Agent"@en ;
    skos:definition "A person, team, tool, or model that takes part in the work."@en .

work:Artifact
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Artifact"@en ;
    skos:definition "A thing being worked on."@en .

work:WorkItem
    a owl:Class ;
    rdfs:label "Work item"@en ;
    skos:definition "A task, question, bug, or decision."@en .

work:Change
    a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Change"@en ;
    skos:definition "One edit, commit, deploy, or revert."@en .

work:Topic
    a owl:Class ;
    rdfs:subClassOf work:Concept ;
    rdfs:label "Topic"@en ;
    skos:definition "What an episode or artifact is about."@en .

work:Person
    a owl:Class ;
    rdfs:subClassOf work:Agent ;
    rdfs:label "Person"@en ;
    skos:definition "A named human."@en ;
    rdfs:seeAlso schema:Person .

work:Organization
    a owl:Class ;
    rdfs:subClassOf work:Agent ;
    rdfs:label "Organization"@en ;
    skos:definition "A company, team, community, or other group."@en ;
    rdfs:seeAlso schema:Organization .

work:Product
    a owl:Class ;
    rdfs:subClassOf work:Artifact ;
    rdfs:label "Product"@en ;
    skos:definition "A named product, service, application, library, or tool."@en ;
    rdfs:seeAlso schema:Product , schema:SoftwareApplication .

work:Project
    a owl:Class ;
    rdfs:label "Project"@en ;
    skos:definition "A named project or initiative."@en ;
    rdfs:seeAlso schema:Project .

work:Place
    a owl:Class ;
    rdfs:label "Place"@en ;
    skos:definition "A location such as a city, country, site, or address."@en ;
    rdfs:seeAlso schema:Place .

work:Event
    a owl:Class ;
    rdfs:label "Event"@en ;
    skos:definition "Something that happens at a time, such as a meeting, release, or incident."@en ;
    rdfs:seeAlso schema:Event .

work:Document
    a owl:Class ;
    rdfs:subClassOf work:Artifact ;
    rdfs:label "Document"@en ;
    skos:definition "A written work such as a file, page, specification, or note."@en ;
    rdfs:seeAlso schema:CreativeWork , schema:DigitalDocument .

work:Concept
    a owl:Class ;
    rdfs:label "Concept"@en ;
    skos:definition "An idea, technique, or subject being discussed."@en ;
    rdfs:seeAlso schema:DefinedTerm .

work:Status
    a owl:Class ;
    rdfs:label "Status"@en ;
    skos:definition "An optional status value. The four individuals are not a closed list."@en .

work:Open
    a work:Status ;
    rdfs:label "Open"@en ;
    skos:definition "The work is open."@en .

work:Closed
    a work:Status ;
    rdfs:label "Closed"@en ;
    skos:definition "The work is closed."@en .

work:Merged
    a work:Status ;
    rdfs:label "Merged"@en ;
    skos:definition "The change was merged."@en .

work:Reverted
    a work:Status ;
    rdfs:label "Reverted"@en ;
    skos:definition "The change was reverted."@en .

work:mentions
    a owl:ObjectProperty ;
    rdfs:label "mentions"@en ;
    skos:definition "A text or record mentions an entity. An episode IRI may be the subject, so this property has no domain and no range."@en ;
    owl:inverseOf work:mentionedIn .

work:mentionedIn
    a owl:ObjectProperty ;
    rdfs:label "mentioned in"@en ;
    skos:definition "An entity is mentioned in a text or record."@en ;
    owl:inverseOf work:mentions .

work:about
    a owl:ObjectProperty ;
    rdfs:label "about"@en ;
    skos:definition "A record or artifact is about a topic or entity."@en ;
    owl:inverseOf work:subjectOf .

work:subjectOf
    a owl:ObjectProperty ;
    rdfs:label "subject of"@en ;
    skos:definition "A topic or entity is the subject of a record or artifact."@en ;
    owl:inverseOf work:about .

work:partOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    skos:definition "This thing is part of a larger thing."@en ;
    owl:inverseOf work:hasPart .

work:hasPart
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    skos:definition "This thing has the other thing as a part."@en ;
    owl:inverseOf work:partOf .

work:addresses
    a owl:ObjectProperty ;
    rdfs:label "addresses"@en ;
    skos:definition "A work item addresses an artifact."@en ;
    rdfs:domain work:WorkItem ;
    rdfs:range work:Artifact ;
    owl:inverseOf work:addressedBy .

work:addressedBy
    a owl:ObjectProperty ;
    rdfs:label "addressed by"@en ;
    skos:definition "An artifact is addressed by a work item."@en ;
    owl:inverseOf work:addresses .

work:implements
    a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    skos:definition "A change implements a work item."@en ;
    rdfs:domain work:Change ;
    rdfs:range work:WorkItem ;
    owl:inverseOf work:implementedBy .

work:implementedBy
    a owl:ObjectProperty ;
    rdfs:label "implemented by"@en ;
    skos:definition "A work item is implemented by a change."@en ;
    owl:inverseOf work:implements .

work:dependsOn
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "depends on"@en ;
    skos:definition "This thing depends on another. A thing may depend on many others."@en ;
    owl:inverseOf work:requiredBy .

work:requiredBy
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "required by"@en ;
    skos:definition "This thing is required by another."@en ;
    owl:inverseOf work:dependsOn .

work:authoredBy
    a owl:ObjectProperty ;
    rdfs:label "authored by"@en ;
    skos:definition "This thing was authored by an agent."@en ;
    rdfs:range work:Agent ;
    owl:inverseOf work:authors .

work:authors
    a owl:ObjectProperty ;
    rdfs:label "authors"@en ;
    skos:definition "An agent authors this thing."@en ;
    owl:inverseOf work:authoredBy .
