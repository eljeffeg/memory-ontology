@prefix memory: <http://nova.dev/memory#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

memory:TemporalAssertionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Temporal assertion shape"@en ;
    rdfs:comment "This shape requires rdf:type temporal:TemporalAssertion. A memory record with no type, or typed only memory:TemporalAssertion, fails that check. A record that has the temporal type is also validated by the temporal shape: one reified triple, no temporal:validAt beside temporal:validFrom, and the recordedSequence datatype. This shape does not repeat those checks and does not sh:node them."@en ;
    rdfs:comment "temporal:recordedFrom is optional. A native commit sequence satisfies transaction time when that literal is absent. temporal:recordedSequence is not required on an in-process write."@en ;
    rdfs:comment "Whether temporal:closes agrees with an asserted temporal:validUntil or temporal:recordedUntil on the earlier record is a store check, not a SHACL check, because that end is on the other record."@en ;
    rdfs:comment "An absent session is part of application identity. It is not a graph constraint."@en ;
    rdfs:comment "A record may cite several episodes. Each object is one episode record."@en ;
    sh:property [
        sh:path rdf:type ;
        sh:minCount 1 ;
        sh:hasValue temporal:TemporalAssertion ;
        sh:message "A memory record must be a temporal:TemporalAssertion."@en ;
    ] ;
    sh:property [
        sh:path temporal:validFrom ;
        sh:minCount 1 ;
        sh:message "A memory record is an interval and requires temporal:validFrom."@en ;
        rdfs:comment "A memory record is an interval and requires temporal:validFrom. temporal:validAt is allowed on a temporal assertion that is a single instant. Memory excludes instant-only records."@en ;
    ] ;
    sh:property [
        sh:path temporal:validAt ;
        sh:maxCount 0 ;
        sh:message "A memory record must not carry temporal:validAt. It is an interval with temporal:validFrom, not an instant."@en ;
    ] ;
    sh:property [
        sh:path memory:kind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            memory:Episode
            memory:Belief
            memory:Retraction
            memory:Procedure
            memory:Proposal
            memory:SessionBrief
            memory:TopicBrief
        ) ;
        sh:message "kind is one of Episode, Belief, Retraction, Procedure, Proposal, SessionBrief, or TopicBrief."@en ;
    ] ;
    sh:property [
        sh:path memory:role ;
        sh:maxCount 1 ;
        sh:in ( memory:User memory:Assistant memory:Tool ) ;
        sh:message "role is User, Assistant, or Tool."@en ;
    ] ;
    sh:property [
        sh:path memory:episodeType ;
        sh:maxCount 1 ;
        sh:in ( memory:Decision memory:RouteDecision memory:SpawnDecision memory:ActionDecision ) ;
        sh:message "episodeType is Decision, RouteDecision, SpawnDecision, or ActionDecision."@en ;
    ] ;
    sh:property [
        sh:path memory:target ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "target is one IRI."@en ;
    ] ;
    sh:property [
        sh:path memory:evidence ;
        sh:class temporal:TemporalAssertion ;
        rdfs:comment "The evidence records have to be in the validation load, same caveat as supersedes. Which kind each cited record must have is checked by memory:EvidenceKindShape."@en ;
        sh:message "Each evidence value is a temporal assertion."@en ;
    ] ;
    sh:property [
        sh:path memory:agent ;
        sh:maxCount 1 ;
        sh:class prov:Agent ;
    ] ;
    sh:property [
        sh:path memory:application ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "application is an optional string."@en ;
    ] ;
    sh:property [
        sh:path memory:model ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "model is an optional string."@en ;
    ] ;
    sh:property [
        sh:path memory:session ;
        sh:maxCount 1 ;
        sh:class memory:Session ;
    ] ;
    sh:property [
        sh:path memory:policy ;
        sh:maxCount 1 ;
        sh:class memory:Policy ;
    ] ;
    sh:property [
        sh:path memory:confidence ;
        sh:maxCount 1 ;
        sh:or (
            [
                sh:datatype xsd:decimal ;
                sh:minInclusive 0 ;
                sh:maxInclusive 1 ;
            ]
            [
                sh:datatype xsd:integer ;
                sh:minInclusive 0 ;
                sh:maxInclusive 1 ;
            ]
        ) ;
        sh:message "confidence is an optional value from 0 to 1, as xsd:decimal or xsd:integer."@en ;
    ] ;
    sh:property [
        sh:path memory:lexical ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
        sh:message "lexical is a string or a language-tagged string."@en ;
    ] .

memory:EvidenceKindShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:evidence ;
    rdfs:label "Evidence kind by citing kind"@en ;
    rdfs:comment "A topic brief cites session briefs. A decision episode cites episodes or beliefs. Every other record cites episodes, so a generated brief is never evidence for a belief, procedure, proposal, session brief, or decision."@en ;
    sh:message "A topic brief cites session briefs. A decision episode cites episodes or beliefs. Any other record cites episodes."@en ;
    sh:or (
        [
            sh:path memory:kind ;
            sh:hasValue memory:TopicBrief ;
        ]
        [
            sh:path memory:evidence ;
            sh:node memory:EvidenceEpisodeShape ;
        ]
        [
            sh:node memory:DecisionEpisodeShape ;
            sh:property [
                sh:path memory:evidence ;
                sh:node memory:EvidenceEpisodeOrBeliefShape ;
            ] ;
        ]
    ) ;
    sh:or (
        [
            sh:not [ sh:path memory:kind ; sh:hasValue memory:TopicBrief ] ;
        ]
        [
            sh:path memory:evidence ;
            sh:node memory:EvidenceSessionBriefShape ;
        ]
    ) .

memory:EvidenceSessionBriefShape
    a sh:NodeShape ;
    rdfs:label "Evidence session brief shape"@en ;
    rdfs:comment "Applied to the evidence of a topic brief. Each cited record is one session brief."@en ;
    sh:property [
        sh:path memory:kind ;
        sh:hasValue memory:SessionBrief ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The cited record has kind SessionBrief."@en ;
    ] .

memory:EvidenceEpisodeShape
    a sh:NodeShape ;
    rdfs:label "Evidence episode shape"@en ;
    rdfs:comment "Applied to the evidence of every record that is not a topic brief. Each cited record is one episode."@en ;
    sh:property [
        sh:path memory:kind ;
        sh:hasValue memory:Episode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The cited record has kind Episode."@en ;
    ] .

memory:EvidenceEpisodeOrBeliefShape
    a sh:NodeShape ;
    rdfs:label "Evidence episode or belief shape"@en ;
    rdfs:comment "Applied to the evidence of a decision episode. Each cited record is one episode or one belief."@en ;
    sh:property [
        sh:path memory:kind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( memory:Episode memory:Belief ) ;
        sh:message "The cited record has kind Episode or Belief."@en ;
    ] .

memory:DecisionEpisodeShape
    a sh:NodeShape ;
    rdfs:label "Decision episode"@en ;
    rdfs:comment "An episode with an episode type. Every allowed episode type is Decision or a narrower decision, and TemporalAssertionShape limits the values."@en ;
    sh:property [
        sh:path memory:kind ;
        sh:hasValue memory:Episode ;
    ] ;
    sh:property [
        sh:path memory:episodeType ;
        sh:minCount 1 ;
    ] .

memory:TargetedDecisionShape
    a sh:NodeShape ;
    rdfs:label "Targeted decision"@en ;
    rdfs:comment "A route, spawn, or action decision. Used to require and to restrict memory:target."@en ;
    sh:property [
        sh:path memory:episodeType ;
        sh:minCount 1 ;
        sh:in ( memory:RouteDecision memory:SpawnDecision memory:ActionDecision ) ;
    ] .

memory:TargetRequiredShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Targeted decision names a target and evidence"@en ;
    rdfs:comment "A route, spawn, or action decision names what it chose and cites what it rests on. A plain Decision episode needs neither."@en ;
    sh:message "A route, spawn, or action decision names a target and cites evidence."@en ;
    sh:or (
        [ sh:not memory:TargetedDecisionShape ]
        [
            sh:property [ sh:path memory:target ; sh:minCount 1 ] ;
            sh:property [ sh:path memory:evidence ; sh:minCount 1 ] ;
        ]
    ) .

memory:TargetOnlyOnTargetedDecisionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:target ;
    rdfs:label "Target only on a targeted decision"@en ;
    sh:message "memory:target is allowed only on a route, spawn, or action decision episode."@en ;
    rdfs:comment "Episode types are allowed only on episodes, so a targeted decision is always an episode."@en ;
    sh:node memory:TargetedDecisionShape .

memory:ActionDecisionPolicyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:episodeType ;
    rdfs:label "Action decision names a policy"@en ;
    rdfs:comment "An action has effects outside memory, so the record names the policy that allowed it. Whether the policy was honored is checked by the system that runs the action."@en ;
    sh:message "An action decision names the policy that allowed it."@en ;
    sh:or (
        [ sh:not [ sh:path memory:episodeType ; sh:hasValue memory:ActionDecision ] ]
        [ sh:path memory:policy ; sh:minCount 1 ]
    ) .

memory:SpawnTargetSessionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:episodeType ;
    rdfs:label "Spawn decision targets a session"@en ;
    rdfs:comment "A spawn decision starts a session, so its target is a memory:Session. As with every sh:class check, the target's type must be in the validation data."@en ;
    sh:message "A spawn decision targets a memory:Session."@en ;
    sh:or (
        [ sh:not [ sh:path memory:episodeType ; sh:hasValue memory:SpawnDecision ] ]
        [ sh:path memory:target ; sh:class memory:Session ]
    ) .

memory:RouteTargetAgentShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:episodeType ;
    rdfs:label "Route decision targets an agent"@en ;
    rdfs:comment "A route decision hands work to an agent, so its target is a prov:Agent. As with every sh:class check, the target's type must be in the validation data."@en ;
    sh:message "A route decision targets a prov:Agent."@en ;
    sh:or (
        [ sh:not [ sh:path memory:episodeType ; sh:hasValue memory:RouteDecision ] ]
        [ sh:path memory:target ; sh:class prov:Agent ]
    ) .

memory:SourceShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:source ;
    rdfs:label "External source"@en ;
    rdfs:comment "A source is an IRI outside memory. Whether it is a memory record can be checked only when it is in the validation load. A source that is absent passes. A decision episode may name the external resource that prompted it, such as an alert."@en ;
    sh:or (
        [
            sh:path memory:kind ;
            sh:minCount 1 ;
            sh:in ( memory:Belief memory:Procedure memory:Proposal memory:Retraction ) ;
        ]
        [ sh:node memory:DecisionEpisodeShape ]
    ) ;
    sh:message "memory:source is allowed only on a belief, procedure, proposal, retraction, or decision episode."@en ;
    sh:property [
        sh:path memory:source ;
        sh:nodeKind sh:IRI ;
        sh:node memory:NotMemoryRecordShape ;
        sh:message "memory:source names an external resource by IRI, not a memory record."@en ;
    ] .

memory:NotMemoryRecordShape
    a sh:NodeShape ;
    rdfs:label "Not a memory record"@en ;
    sh:property [
        sh:path memory:kind ;
        sh:maxCount 0 ;
    ] .

memory:RoleOnlyOnEpisodeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Role only on an episode"@en ;
    sh:message "A role is allowed only on an episode."@en ;
    sh:or (
        [ sh:path memory:kind ; sh:hasValue memory:Episode ]
        [ sh:path memory:role ; sh:maxCount 0 ]
    ) .

memory:EpisodeTypeOnlyOnEpisodeShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Episode type only on an episode"@en ;
    sh:message "An episode type is allowed only on an episode."@en ;
    sh:or (
        [ sh:path memory:kind ; sh:hasValue memory:Episode ]
        [ sh:path memory:episodeType ; sh:maxCount 0 ]
    ) .

memory:ConfidenceOnlyOnBeliefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Confidence only on a belief"@en ;
    sh:message "Confidence is allowed only on a belief."@en ;
    sh:or (
        [ sh:path memory:kind ; sh:hasValue memory:Belief ]
        [ sh:path memory:confidence ; sh:maxCount 0 ]
    ) .

memory:RetractionIsClosureShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Retraction is a closure"@en ;
    rdfs:comment "A memory record is a temporal:Closure exactly when its kind is memory:Retraction. Every other kind reifies a triple. temporal:ClosureShape then requires temporal:supersedes and temporal:closes and forbids a reified triple. Whether temporal:closes agrees with an asserted end on the earlier record is a store check, not a SHACL check, because that end is on the other record."@en ;
    sh:message "A memory record is typed temporal:Closure exactly when its kind is memory:Retraction."@en ;
    sh:xone (
        [ sh:path memory:kind ; sh:hasValue memory:Retraction ]
        [ sh:not [ sh:path rdf:type ; sh:hasValue temporal:Closure ] ]
    ) .

memory:SupersedesClosesClockShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Supersession names a clock"@en ;
    rdfs:comment "A domain record is not a target. A domain record that supersedes and carries no temporal:closes is a world change: it closes valid time, and this shape does not reject it. The allowed clock values are checked by temporal:ClosesShape."@en ;
    sh:message "A record that supersedes another must say which clock it closes."@en ;
    sh:or (
        [ sh:path temporal:supersedes ; sh:maxCount 0 ]
        [ sh:path temporal:closes ; sh:minCount 1 ]
    ) .

memory:RetractionHasNoLexicalShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:kind ;
    rdfs:label "Retraction has no lexical text"@en ;
    sh:message "A retraction has no lexical text."@en ;
    sh:or (
        [ sh:not [ sh:path memory:kind ; sh:hasValue memory:Retraction ] ]
        [ sh:path memory:lexical ; sh:maxCount 0 ]
    ) .

memory:BriefPropositionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:reifies , rdf:predicate ;
    rdfs:label "Brief proposition"@en ;
    rdfs:comment "A brief record reifies a triple whose predicate is memory:brief. Its subject is the session or topic, and its object is the Markdown, as an xsd:string or an rdf:langString. Only a session brief or a topic brief reifies a memory:brief triple. A reifier with no memory:kind is not a memory record and is not checked. The triple is read from either reification form: an rdf:reifies triple term, or rdf:predicate and rdf:object on the record."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A session brief or topic brief reifies a memory:brief triple, and no other memory record does."@en ;
        sh:prefixes memory:BriefShapePrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this memory:kind ?kind .
                {
                    $this rdf:reifies ?triple .
                    BIND (PREDICATE(?triple) AS ?p)
                } UNION {
                    $this rdf:predicate ?p .
                }
                BIND (?p = memory:brief AS ?briefTriple)
                BIND (?kind IN (memory:SessionBrief, memory:TopicBrief) AS ?briefRecord)
                FILTER (?briefTriple != ?briefRecord)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The object of a reified memory:brief triple is an xsd:string or an rdf:langString."@en ;
        sh:prefixes memory:BriefShapePrefixes ;
        sh:select """
            SELECT $this WHERE {
                {
                    $this rdf:reifies ?triple .
                    BIND (PREDICATE(?triple) AS ?p)
                    BIND (OBJECT(?triple) AS ?o)
                } UNION {
                    $this rdf:predicate ?p ;
                        rdf:object ?o .
                }
                FILTER (?p = memory:brief)
                FILTER (!isLiteral(?o) || !(datatype(?o) IN (xsd:string, rdf:langString)))
            }
        """ ;
    ] .

memory:BriefShapePrefixes
    sh:declare [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "xsd" ;
        sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ;
    ] , [
        sh:prefix "memory" ;
        sh:namespace "http://nova.dev/memory#"^^xsd:anyURI ;
    ] .

memory:TopicTagOnlyOnBriefShape
    a sh:NodeShape ;
    sh:targetSubjectsOf memory:topicTag ;
    rdfs:label "Topic tag only on a brief"@en ;
    sh:property [
        sh:path memory:kind ;
        sh:minCount 1 ;
        sh:in ( memory:SessionBrief memory:TopicBrief ) ;
        sh:message "memory:topicTag is allowed only on a session brief or a topic brief."@en ;
    ] ;
    sh:property [
        sh:path memory:topicTag ;
        sh:datatype xsd:string ;
        sh:message "memory:topicTag is a string."@en ;
    ] .
