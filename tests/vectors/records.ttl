    memory:agent ex:curator ;
    temporal:supersedes ex:v9 ;
    temporal:closes temporal:ValidTime , temporal:RecordedTime ;
    temporal:validFrom "2026-10-20T00:00:00Z"^^xsd:dateTimeStamp ;
    temporal:recordedFrom "2026-11-01T00:00:00Z"^^xsd:dateTimeStamp .

