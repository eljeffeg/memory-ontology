# Closes with no successor.

# v1 was recorded with its end already known.
ex:x-v1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:camera rdfs:subClassOf ex:device )>> ;
    memory:kind memory:Retraction ;
    memory:agent ex:curator ;
    temporal:supersedes ex:v1 ;
    temporal:closes temporal:ValidTime ;
    temporal:validFrom "2026-03-10T12:00:00Z"^^xsd:dateTimeStamp ;
    temporal:recordedFrom "2026-03-01T09:00:00Z"^^xsd:dateTimeStamp .

# v8 is corrected; recorded 2026-09-15T00:00:00Z.
ex:x-c3 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:tripod rdfs:subClassOf ex:sensor )>> ;
    memory:kind memory:Retraction ;
    memory:agent ex:curator ;
    temporal:supersedes ex:v8 ;
