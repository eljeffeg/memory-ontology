# An action has effects outside memory, so it needs a policy.
# expect: An action decision names the policy that allowed it.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix memory: <http://nova.dev/memory#> .
@prefix ex: <https://example.org/> .

ex:episode-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:alice ex:said ex:outage-reported )>> ;
    memory:kind memory:Episode ;
    memory:role memory:User ;
    temporal:validFrom "2026-11-01T10:00:00Z"^^xsd:dateTimeStamp .

ex:decision-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:triage-agent ex:decided ex:restart-service )>> ;
    memory:kind memory:Episode ;
    memory:episodeType memory:ActionDecision ;
    memory:target ex:restart-service ;
    memory:evidence ex:episode-1 ;
    temporal:validFrom "2026-11-01T10:05:00Z"^^xsd:dateTimeStamp .
