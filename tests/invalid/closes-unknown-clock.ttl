# A domain record names a clock that is not ValidTime or RecordedTime.
# expect: closes is ValidTime, RecordedTime, or both.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix memory: <http://nova.dev/memory#> .
@prefix ex: <https://example.org/> .

ex:price-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:widget ex:price 12 )>> ;
    temporal:validFrom "2026-11-01T00:00:00Z"^^xsd:dateTimeStamp .

ex:price-2 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:widget ex:price 21 )>> ;
    temporal:supersedes ex:price-1 ;
    temporal:closes ex:WallClock ;
    temporal:validFrom "2026-11-01T00:00:00Z"^^xsd:dateTimeStamp .
