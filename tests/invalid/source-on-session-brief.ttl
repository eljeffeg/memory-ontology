# A generated brief summarizes memory and names no external source.
# expect: memory:source is allowed only on a belief, procedure, proposal, or retraction.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix memory: <http://nova.dev/memory#> .
@prefix ex: <https://example.org/> .

ex:episode-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:alice ex:said ex:release-planned )>> ;
    memory:kind memory:Episode ;
    memory:role memory:User ;
    temporal:validFrom "2026-11-01T10:00:00Z"^^xsd:dateTimeStamp .

ex:session-brief-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:session-1 memory:brief "Alice said the release is planned." )>> ;
    memory:kind memory:SessionBrief ;
    memory:evidence ex:episode-1 ;
    memory:source ex:report-123 ;
    temporal:validFrom "2026-11-01T11:00:00Z"^^xsd:dateTimeStamp .
