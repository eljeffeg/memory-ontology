# memory:Brief groups the brief kinds and is not a record kind.
# expect: kind is one of Episode, Belief, Retraction, Procedure, Proposal, SessionBrief, or TopicBrief.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix memory: <http://nova.dev/memory#> .
@prefix ex: <https://example.org/> .

ex:record-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:alice ex:said ex:hello )>> ;
    memory:kind memory:Brief ;
    temporal:validFrom "2026-11-01T10:00:00Z"^^xsd:dateTimeStamp .
