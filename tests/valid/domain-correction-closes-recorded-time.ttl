# Domain correction: a record with no memory:kind closes recorded time.
# The earlier price was entered wrong. The closing record has its own
# recorded time and agent.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix memory: <http://nova.dev/memory#> .
@prefix ex: <https://example.org/> .

ex:price-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:widget ex:price 12 )>> ;
    prov:wasAttributedTo ex:clerk ;
    temporal:validFrom "2026-11-01T00:00:00Z"^^xsd:dateTimeStamp ;
    temporal:recordedFrom "2026-11-01T09:00:00Z"^^xsd:dateTimeStamp .

ex:price-2 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:widget ex:price 21 )>> ;
    prov:wasAttributedTo ex:auditor ;
    temporal:supersedes ex:price-1 ;
    temporal:closes temporal:RecordedTime ;
    temporal:validFrom "2026-11-01T00:00:00Z"^^xsd:dateTimeStamp ;
    temporal:recordedFrom "2026-11-04T15:00:00Z"^^xsd:dateTimeStamp .
