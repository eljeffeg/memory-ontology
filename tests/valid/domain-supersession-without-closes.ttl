# Domain world change: a domain record that supersedes with no
# temporal:closes closes valid time. The price changed on 2026-11-10.
# price-1 carries a stored copy of its valid end, taken from price-2.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix temporal: <http://nova.dev/temporal#> .
@prefix memory: <http://nova.dev/memory#> .
@prefix ex: <https://example.org/> .

ex:price-1 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:widget ex:price 21 )>> ;
    temporal:validFrom "2026-11-01T00:00:00Z"^^xsd:dateTimeStamp ;
    temporal:validUntil "2026-11-10T00:00:00Z"^^xsd:dateTimeStamp ;
    temporal:recordedFrom "2026-11-01T09:00:00Z"^^xsd:dateTimeStamp .

ex:price-2 a temporal:TemporalAssertion ;
    rdf:reifies <<( ex:widget ex:price 25 )>> ;
    temporal:supersedes ex:price-1 ;
    temporal:validFrom "2026-11-10T00:00:00Z"^^xsd:dateTimeStamp ;
    temporal:recordedFrom "2026-11-09T12:00:00Z"^^xsd:dateTimeStamp .
